# ── PromoGames backend environment ──
# Copy to .env and fill real values. NEVER commit .env (it is gitignored;
# if it was committed previously, rotate the secret and `git rm --cached .env`).

PORT=8080

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=quizuser
DB_PASSWORD=change_me_strong_db_password
DB_NAME=quiz_platform

# Auth — MUST be a long random string. Tokens are unforgeable only if this is set.
JWT_SECRET=please_generate_a_long_random_secret_at_least_32_chars

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Translation (LibreTranslate)
LIBRETRANSLATE_URL=http://localhost:5050
TRANSLATE_SOURCE=en

# CORS — comma-separated list of allowed frontend origins (same-origin if empty)
ALLOWED_ORIGINS=
